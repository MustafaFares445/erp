{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "dedoc/scramble": "^0.13.35",
        "filament/filament": "~5.0",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "stripe/stripe-php": "^22.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "roave/security-advisories": "dev-latest",
        "spatie/guidelines-skills": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "Composer\\Config::disableProcessTimeout",
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:docs": "@php scripts/docs-check.php",
        "test:types": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=1G"
        ],
        "test:type-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:fast": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest --compact --parallel --max-processes=16 --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php .github/scripts/run-coverage.php"
        ],
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=1G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Unit --compact --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test": [
            "@test:full"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:feature": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature --compact --parallel --max-processes=16 --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test:behavioral": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest --compact --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test:profile": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest --compact --profile --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test:shards:update": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest --compact --parallel --update-shards --exclude-group=coverage-only --exclude-group=architecture"
        ],
        "test:changed": "@php scripts/test-changed.php",
        "test:accounting": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Accounting --compact",
        "test:api": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Api --compact",
        "test:crm": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Crm --compact",
        "test:employees": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Employees --compact",
        "test:filament": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Filament --compact",
        "test:inventory": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Inventory --compact",
        "test:notifications": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Notifications --compact",
        "test:performance": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Performance --compact",
        "test:payments": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Payments --compact",
        "test:purchasing": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Purchasing --compact",
        "test:sales": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Sales --compact",
        "test:settings": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Settings --compact",
        "test:shipments": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Shipments --compact",
        "test:support": "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Feature/Support --compact",
        "test:full": [
            "@test:lint",
            "@test:docs",
            "@test:architecture",
            "@test:types",
            "@test:type-coverage",
            "@test:coverage"
        ],
        "test:architecture": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest tests/Unit/ArchTest.php --compact"
        ],
        "test:tia": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=0 -d xdebug.mode=off vendor/bin/pest --compact --parallel --max-processes=16 --tia --locally --exclude-group=coverage-only --exclude-group=architecture"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
