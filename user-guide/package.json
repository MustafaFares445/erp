{
  "name": "ierp-user-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "docs": "npm run docs:generate",
    "docs:generate": "php ../scripts/user-guide-manifest.php --write && python scripts/generate-content.py",
    "docs:validate": "php ../scripts/user-guide-manifest.php --check && node scripts/validate-content.mjs",
    "docs:dev": "vitepress dev --host 0.0.0.0 --port 5174",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview --host 0.0.0.0 --port 4174",
    "docs:validate-built": "node scripts/validate-built.mjs",
    "docs:check": "npm run docs:validate && vitepress build && npm run docs:validate-built",
    "docs:demo:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-screenshot-demo.ps1",
    "docs:demo:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve-screenshot-demo.ps1",
    "docs:capture:targets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/resolve-screenshot-targets.ps1",
    "docs:capture:plan": "node scripts/capture-screenshots.mjs",
    "docs:capture:check": "node scripts/capture-screenshots.mjs --check",
    "docs:qa:sales-livewire": "node scripts/capture-screenshots.mjs --sales-livewire-qa --locale=both",
    "docs:capture": "node scripts/capture-screenshots.mjs --capture"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "vitepress": "1.6.4"
  }
}
